CONFIG_KSU=y
CONFIG_KSU_FEATURE_ADBROOT=y
CONFIG_KSU_DEBUG=n
CONFIG_KSU_DISABLE_MANAGER=n
CONFIG_KSU_DISABLE_POLICY=n
CONFIG_KPM=n
CONFIG_KSU_SUSFS=y
CONFIG_KSU_SUSFS_SUS_PATH=y
CONFIG_KSU_SUSFS_SUS_MOUNT=y
CONFIG_KSU_SUSFS_SUS_KSTAT=y
CONFIG_KSU_SUSFS_SPOOF_UNAME=y
CONFIG_KSU_SUSFS_ENABLE_LOG=n
CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS=y
CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG=y
CONFIG_KSU_SUSFS_OPEN_REDIRECT=y
CONFIG_KSU_SUSFS_SUS_MAP=y
CONFIG_LTO_CLANG=y
CONFIG_LTO_CLANG_FULL=y
CONFIG_CFI_CLANG=y
CONFIG_CFI_CLANG_SHADOW=y
CONFIG_SHADOW_CALL_STACK=y
CONFIG_KASAN=y
CONFIG_KASAN_HW_TAGS=y

# --- fixes required to build the factory config off-device ----------------
# The stock .config carries TRIM_UNUSED_KSYMS=y plus a whitelist path that only
# exists on OnePlus's GKI buildbot:
#   CONFIG_UNUSED_KSYMS_WHITELIST="/buildbot/src/android/common-android12-5.10-2022-12/..."
# -> `GEN include/generated/autoksyms.h` dies with "whitelist file not found".
# Disabling the trimming keeps *more* symbols exported than stock, which can
# never break a vendor module import, and it does not touch any symbol CRC.
# CONFIG_TRIM_UNUSED_KSYMS is not set
CONFIG_UNUSED_KSYMS_WHITELIST=""
